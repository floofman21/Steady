# Postgres (Neon). The Vercel Neon integration injects DATABASE_URL (pooled)
# and DATABASE_URL_UNPOOLED (direct, used by drizzle-kit for migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/steady
DATABASE_URL_UNPOOLED=

# Auth.js (Phase 3)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
ALLOWED_EMAIL_DOMAINS=example.com

# Email + cron (Phase 5)
RESEND_API_KEY=
EMAIL_FROM="Steady <steady@example.com>"
CRON_SECRET=
